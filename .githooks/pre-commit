#!/usr/bin/env bash
# Git Pre-commit Hook: Run fast syntax validation and check secrets
echo "Running Pre-Commit Quality Checks..."

# Prevent committing raw API secrets
if git diff --cached | grep -E "GROQ_API_KEY\s*=\s*['\"][a-zA-Z0-9_-]{20,}['\"]"; then
    echo "================================================================="
    echo " [SECURITY ERROR] Potential hardcoded API key detected in commit!"
    echo " Store secrets in .env or environment variables instead."
    echo "================================================================="
    exit 1
fi

echo "Pre-commit checks passed successfully."
exit 0
